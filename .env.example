# https://aistudio.google.com/apikey — use a free-tier project without billing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Managed Cloudflare AI Gateway (both required); server-side credentials only.
# GEMINI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/ACCOUNT_ID/GATEWAY_ID/google-ai-studio
# GEMINI_GATEWAY_TOKEN=
# Gateway mode connects directly to Cloudflare and ignores GEMINI_PROXY_URL.
# Setup: docs/cloudflare-gateway.md
# Optional HTTP CONNECT proxy, server-side only:
# GEMINI_PROXY_URL=http://127.0.0.1:18080
# Optional local simulation; never set this to an untrusted server with a real key:
# GEMINI_BASE_URL=http://127.0.0.1:4900/gemini
# Total deadline, including one retry; each attempt is bounded separately:
# GEMINI_TIMEOUT_MS=20000
# GEMINI_ATTEMPT_TIMEOUT_MS=10000

# Price worker: runs every 72 hours while the Node server is running.
# REFRESH_WORKER_ENABLED=0
# Defer the first crawl only when initializing a new schedule (saved due runs still catch up):
# NO_REFRESH=1

# Public deployment (base path must also be set during npm run build):
# APP_BASE_PATH=/abrgozin
# PUBLIC_URL=https://abeheshti.ir/abrgozin
# HOST=0.0.0.0
# PORT=4321
# DATA_DIR=/data
# MODEL_CACHE_DIR=/data/models
